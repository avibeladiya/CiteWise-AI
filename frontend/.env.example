# ─────────────────────────────────────────────────────────────────────────────
#  CiteWise AI — Frontend Environment Variables
#  Copy to .env.local for local development.
#  On Vercel, add these in Project Settings → Environment Variables.
#  IMPORTANT: All Vite env vars MUST start with VITE_
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Set to your Render backend URL once deployed, e.g.:
#   VITE_API_URL=https://citewise-ai-backend.onrender.com
#
# Leave EMPTY to run in fully local mock mode (no backend required):
VITE_API_URL=

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use the in-browser mock even if VITE_API_URL is set.
# Set to "false" (or remove) to use the real Render backend.
VITE_USE_MOCK=true
