# ─────────────────────────────────────────────────────────────────────────────
#  CiteWise AI — Backend Environment Variables
#  Copy this file to .env for local development.
#  On Render, set these in the Environment tab — do NOT commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Credentials ───────────────────────────────────────────────────────────
# Required: IAM user/role with access to S3, DynamoDB, and Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
# Region where Titan Embeddings V2 + Claude 3 Haiku are enabled
# (must match AWS_REGION unless you have cross-region access)
BEDROCK_REGION=us-east-1

# ── S3 ────────────────────────────────────────────────────────────────────────
# Bucket name for raw document storage (created by SAM template)
S3_BUCKET=citewise-documents-YOUR_ACCOUNT_ID-dev

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# Table names (created by SAM template)
DOCUMENTS_TABLE=citewise-documents-dev
CHUNKS_TABLE=citewise-chunks-dev

# ── RAG Tuning ────────────────────────────────────────────────────────────────
TOP_K=5
SIM_THRESHOLD=0.25
MAX_PAGES=20

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for open access in dev)
# In production, set this to your Vercel frontend URL:
# CORS_ORIGINS=https://citewise-ai.vercel.app
CORS_ORIGINS=*

# ── Server ────────────────────────────────────────────────────────────────────
# Render sets PORT automatically — leave this unset unless running locally
# PORT=8000
